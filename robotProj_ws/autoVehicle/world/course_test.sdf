<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="course_test">

    <!-- directional light -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- COURSE: 20000mm flat -> 1600mm 45deg uphill -> 1600mm disturbance -> T-junction -->
    <!-- Path width: 0.3m   Wall height: 0.2m   Wall thickness: 0.1m   Floor thickness: 0.05m -->
    <!-- ============================================================ -->

    <model name="test_course">
      <static>true</static>

      <!-- ===== SEGMENT 1: flat straight, X = 0 -> 20, Z = 0 ===== -->
      <link name="seg1_floor">
        <pose>10.0 0 0.025 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>20.0 0.3 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.3 0.05</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name="seg1_wall_left">
        <pose>10.0 -0.2 0.1 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>20.0 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <link name="seg1_wall_right">
        <pose>10.0 0.2 0.1 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>20.0 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- ===== SEGMENT 2: 45deg uphill ramp, length 1.6m along slope ===== -->
      <!-- delta_X = delta_Z = 1.6 * cos45 = 1.1314 -->
      <!-- start (20,0,0), end (21.1314,0,1.1314), centre (20.5657,0,0.5657) -->
      <link name="seg2_floor">
        <pose>20.5657 0 0.5657 0 -0.7854 0</pose>
        <collision name="collision">
          <geometry><box><size>1.6 0.3 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.3 0.05</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name="seg2_wall_left">
        <pose>20.5657 -0.2 0.5657 0 -0.7854 0</pose>
        <collision name="collision">
          <geometry><box><size>1.6 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <link name="seg2_wall_right">
        <pose>20.5657 0.2 0.5657 0 -0.7854 0</pose>
        <collision name="collision">
          <geometry><box><size>1.6 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- ===== SEGMENT 3: disturbance (ground bumps), X = 21.1314 -> 22.5814, Z = 1.1314 ===== -->
      <link name="seg3_floor">
        <pose>21.8564 0 1.1241 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.45 0.3 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.45 0.3 0.05</size></box></geometry>
          <material><ambient>0.65 0.60 0.55 1</ambient><diffuse>0.65 0.60 0.55 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_wall_left">
        <pose>21.8564 -0.2 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.45 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.45 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_wall_right">
        <pose>21.8564 0.2 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.45 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.45 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- disturbance bumps on seg3 floor surface (Z_top = 1.1314) -->
      <link name="seg3_bump_01">
        <pose>21.28 0.04 1.1541 0 0 0.0</pose>
        <collision name="collision">
          <geometry><box><size>0.06 0.16 0.010</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.16 0.010</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.55 0.42 0.30 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_bump_02">
        <pose>21.48 -0.06 1.1531 0 0 0.2</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.14 0.008</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.14 0.008</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.55 0.42 0.30 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_bump_03">
        <pose>21.68 0.02 1.1541 0 0 0.1</pose>
        <collision name="collision">
          <geometry><box><size>0.07 0.18 0.010</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.07 0.18 0.010</size></box></geometry>
          <material><ambient>0.50 0.38 0.28 1</ambient><diffuse>0.50 0.38 0.28 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_bump_04">
        <pose>21.90 -0.03 1.1536 0 0 -0.15</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.12 0.009</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.12 0.009</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.55 0.42 0.30 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_bump_05">
        <pose>22.12 0.07 1.1541 0 0 0.3</pose>
        <collision name="collision">
          <geometry><box><size>0.06 0.15 0.010</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.15 0.010</size></box></geometry>
          <material><ambient>0.50 0.38 0.28 1</ambient><diffuse>0.50 0.38 0.28 1</diffuse></material>
        </visual>
      </link>

      <link name="seg3_bump_06">
        <pose>22.36 -0.05 1.1526 0 0 -0.25</pose>
        <collision name="collision">
          <geometry><box><size>0.05 0.13 0.007</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.13 0.007</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.55 0.42 0.30 1</diffuse></material>
        </visual>
      </link>

      <!-- ===== SEGMENT 4: T-junction, approach joins at X = 22.7314, cross path spans Y = -1.6 -> 1.6 ===== -->

      <!-- junction floor: 0.5m wide in X, 3.2m long in Y, at Z = 1.1314 -->
      <link name="junction_floor">
        <pose>22.7314 0 1.1241 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 3.2 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 3.2 0.05</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- junction left wall, north half (gap at Y ~ 0 for approach arm) -->
      <!-- left wall X = 22.7314 - 0.25 - 0.05 = 22.4814 -->
      <link name="junction_wall_left_north">
        <pose>22.4814 0.9 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 1.4 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.4 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- junction left wall, south half -->
      <link name="junction_wall_left_south">
        <pose>22.4814 -0.9 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 1.4 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.4 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- junction right wall (full length), X = 22.7314 + 0.25 + 0.05 = 22.9814 -->
      <link name="junction_wall_right">
        <pose>22.9814 0 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 3.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.2 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- junction end cap walls at Y = +/-1.6 -->
      <link name="junction_wall_end_pos_y">
        <pose>22.7314 1.65 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

      <link name="junction_wall_end_neg_y">
        <pose>22.7314 -1.65 1.1991 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.5 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.1 0.2</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>

    </model>

  </world>
</sdf>
